# Where the deployment's own .env lives — CORE_SIGNING_SECRET, ORG_ID and
# ADMIN_GRANTS are read from it.
QM_ENV_FILE=/path/to/qm/.env

QM_CORE_URL=http://127.0.0.1:8080

# Reach postgres either through a docker container…
QM_PG_CONTAINER=qm-<org>-pg
# …or with a psql command of your own (takes precedence):
# QM_PSQL=psql postgresql://user:pass@host:5432/qm

# Optional overrides; both are derived from QM_ENV_FILE when unset.
# QM_ORG_ID=
# QM_ACTOR=

# Tier 2 only — the standing-order task posts a real Slack message.
# The user token must belong to a member of the channel; a bot token will not
# work, because the agent filters its own messages and no turn happens.
# QM_SLACK_USER_TOKEN=xoxp-...
# QM_SLACK_CHANNEL=C0...
# QM_BOT_USER_ID=U0...
