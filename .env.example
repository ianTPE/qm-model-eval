# Local deployment: point at the deployment's own .env and the rest is read
# from it (CORE_SIGNING_SECRET, ORG_ID, ADMIN_GRANTS).
QM_ENV_FILE=/path/to/qm/.env

# Fly or AWS: there is no .env on the machine you run this from. Leave
# QM_ENV_FILE unset and supply the three values directly instead:
# CORE_SIGNING_SECRET=...      # fly secrets / AWS Secrets Manager
# ORG_ID=...
# QM_ACTOR=you@example.com     # an org admin

QM_CORE_URL=http://127.0.0.1:8080

# Reach postgres either through a docker container… (one of these two is
# required; there is no default)
QM_PG_CONTAINER=qm-<org>-pg
# …or with a psql command of your own (takes precedence):
# QM_PSQL=psql postgresql://user:pass@host:5432/qm

# Optional overrides; both are derived from QM_ENV_FILE when unset.
# QM_ORG_ID=
# QM_ACTOR=

# Slack-backed tasks only — standing-order-clobber.mjs and ambient-reply.mjs
# post real Slack messages. The user token must belong to a member of the
# channel; a bot token will not work, because the agent filters its own messages
# and no turn happens. QM_BOT_USER_ID is the bot's *user* id (U…), which is what
# qm matches mentions against — the app/bot id (B…) is a different string and
# messages carrying it are not recognised as mentions.
# QM_SLACK_USER_TOKEN=xoxp-...
# QM_SLACK_CHANNEL=C0...
# QM_BOT_USER_ID=U0...
